DATABASE_URL=postgresql+asyncpg://lockin:lockin@localhost:5433/lockin_dev  # pragma: allowlist secret
DATABASE_URL_SYNC=postgresql://lockin:lockin@localhost:5433/lockin_dev  # pragma: allowlist secret
DATABASE_URL_TEST=postgresql+asyncpg://lockin:lockin@localhost:5433/lockin_test  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379

# Google OAuth - create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared JWT secret (32+ chars for local dev)
AUTH_SECRET=change-me-to-a-32-char-random-string
AUTH_URL=http://localhost:3000

# WebAuthn / passkey config
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:3000

# Observability — leave empty to disable
ENV=local
APP_VERSION=0.0.1
GIT_SHA=dev
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=
SENTRY_DSN_API=

# LLM providers (not used until slice 5+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
