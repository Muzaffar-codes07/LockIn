# Copy to .env.local for local dev (or run `pnpm secrets:pull`).
# NEVER commit real secrets.

# Local infra (docker-compose.dev.yml)
DATABASE_URL=postgresql://lockin:lockin_dev@localhost:5432/lockin
TIMESCALE_URL=postgresql://lockin:lockin_dev@localhost:5433/lockin_events
REDIS_URL=redis://localhost:6379

# Google OAuth — create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth v5 — any 32+ char random string for local dev.
# Same value is read by apps/api as JWT_SECRET (via AliasChoices) so the
# HS256 JWS signed by NextAuth verifies on the api side. PR #2 introduces
# this aliasing — until that merges, set both names locally.
AUTH_SECRET=change-me-to-a-32-char-random-string
AUTH_URL=http://localhost:3000

# WebAuthn (apps/api) — used by /v1/webauthn/register/*
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:3000

# Observability — leave empty to disable. CI sets these from Secret Manager.
ENV=local
APP_VERSION=0.0.1
GIT_SHA=dev
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=
SENTRY_DSN_WEB=
SENTRY_DSN_API=
SENTRY_DSN_MCP=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_GIT_SHA=dev
# Sentry source-map upload (CI only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# LLM providers (not used until slice 5+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
